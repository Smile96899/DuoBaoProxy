{
  "dns": {
    "final": "dns-remote",
    "independent_cache": true,
    "rules": [
      {
        "action": "route",
        "domain": [
          "example.org"
        ],
        "domain_keyword": [
          "gpt"
        ],
        "rule_set": [
          "geosite-google"
        ],
        "server": "dns-remote"
      },
      {
        "action": "route",
        "domain_regex": [
          "^cn\\."
        ],
        "domain_suffix": [
          "lan"
        ],
        "rule_set": [
          "geosite-cn"
        ],
        "server": "dns-direct"
      },
      {
        "action": "reject",
        "query_type": [
          32,
          33
        ]
      },
      {
        "action": "reject",
        "domain_suffix": [
          ".lan"
        ]
      }
    ],
    "servers": [
      {
        "detour": "proxy",
        "domain_resolver": "dns-local",
        "server": "dns.google",
        "tag": "dns-remote",
        "type": "https"
      },
      {
        "domain_resolver": "dns-local",
        "server": "doh.pub",
        "tag": "dns-direct",
        "type": "https"
      },
      {
        "tag": "dns-local",
        "type": "local"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "experimental": {
