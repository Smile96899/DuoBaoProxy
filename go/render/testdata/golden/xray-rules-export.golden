{
  "dns": {
    "queryStrategy": "UseIP",
    "servers": [
      {
        "address": "https://dns.google/dns-query",
        "domains": [
          "full:example.org",
          "keyword:gpt",
          "geosite:google"
        ]
      },
      {
        "address": "https://doh.pub/dns-query",
        "domains": [
          "domain:lan",
          "regexp:^cn\\.",
          "geosite:cn"
        ],
        "skipFallback": true
      },
      "localhost"
    ],
    "tag": "dns-in"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 2080,
      "protocol": "mixed",
      "settings": {
        "accounts": [
          {
            "pass": "p",
            "user": "u"
          }
        ],
        "auth": "password",
        "udp": true
      },
      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "enabled": true,
        "routeOnly": true
      },
      "tag": "mixed-in"
    }
  ],
  "log": {
    "loglevel": "info"
  },
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "1.2.3.4",
            "port": 443,
            "users": [
              {
                "encryption": "none",
                "flow": "xtls-rprx-vision",
                "id": "b831c49a-9976-4b45-b675-637e85f25bf0"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "realitySettings": {
          "fingerprint": "chrome",
          "publicKey": "SbVKOEMjK0sIlbwg4akyBg5mL5KZwwB-ed0ZHtgptVU",
          "serverName": "www.microsoft.com",
          "shortId": "6ba85179e30d4fc2"
        },
        "security": "reality"
      },
      "tag": "proxy"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "freedom",
      "tag": "bypass"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "inboundTag": [
          "mixed-in"
        ],
        "network": "udp",
        "outboundTag": "dns-out",
        "port": 53,
        "type": "field"
      },
      {
        "domain": [
          "keyword:ads",
          "geosite:category-ads-all"
        ],
        "outboundTag": "block",
        "type": "field"
      },
      {
        "domain": [
          "full:example.org",
          "keyword:gpt",
          "geosite:google"
        ],
        "outboundTag": "proxy",
        "type": "field"
      },
      {
        "domain": [
          "domain:lan",
          "regexp:^cn\\.",
          "geosite:cn"
        ],
        "outboundTag": "bypass",
        "type": "field"
      },
      {
        "ip": [
          "1.2.3.4/32"
        ],
        "outboundTag": "block",
        "type": "field"
      },
      {
        "ip": [
          "8.8.8.8/32"
        ],
        "outboundTag": "proxy",
        "type": "field"
      },
      {
        "ip": [
          "10.0.0.0/8",
          "geoip:cn",
          "geoip:private"
        ],
        "outboundTag": "bypass",
        "type": "field"
      },
      {
        "network": "udp",
        "outboundTag": "block",
        "port": "135,137,138,139,5353",
        "type": "field"
      },
      {
        "ip": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "outboundTag": "block",
        "type": "field"
      },
      {
        "network": "tcp,udp",
        "outboundTag": "proxy",
        "type": "field"
      }
    ]
  }
}
stats_tags: ["proxy"]
